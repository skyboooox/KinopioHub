{
  "schemaVersion": 1,
  "workspace": {
    "layout": "siblings",
    "root": ".."
  },
  "repositories": [
    {
      "id": "js",
      "name": "KinopioHub.JS",
      "repository": "skyboooox/KinopioHub.JS",
      "path": "KinopioHub.JS",
      "role": "JavaScript SDK",
      "language": "JavaScript",
      "visibility": "public",
      "defaultBranch": "main",
      "license": "GPL-3.0-or-later",
      "environment": {
        "KINOPIO_SKIP_CA_TRUST_INSTALL": "1"
      },
      "setup": [
        [
          "npm",
          "install"
        ]
      ],
      "test": [
        [
          "npm",
          "test"
        ]
      ]
    },
    {
      "id": "python",
      "name": "KinopioHub.py",
      "repository": "skyboooox/KinopioHub.py",
      "path": "KinopioHub.py",
      "role": "Python SDK",
      "language": "Python",
      "visibility": "public",
      "defaultBranch": "main",
      "license": "GPL-3.0-or-later",
      "setup": [
        [
          "uv",
          "sync",
          "--extra",
          "dev"
        ]
      ],
      "test": [
        [
          "uv",
          "run",
          "ruff",
          "check",
          "."
        ],
        [
          "uv",
          "run",
          "mypy",
          "."
        ],
        [
          "uv",
          "run",
          "pytest"
        ]
      ]
    },
    {
      "id": "ros",
      "name": "KinopioHub.ROS",
      "repository": "skyboooox/KinopioHub.ROS",
      "path": "KinopioHub.ROS",
      "role": "ROS 2 RAM and live-control bridge",
      "language": "Python",
      "visibility": "public",
      "defaultBranch": "main",
      "license": "GPL-3.0-or-later",
      "setup": [
        [
          "uv",
          "venv",
          "--system-site-packages"
        ],
        [
          "uv",
          "pip",
          "install",
          "--python",
          ".venv/bin/python",
          "-e",
          "../KinopioHub.py",
          "-e",
          ".[test]"
        ]
      ],
      "test": [
        [
          ".venv/bin/python",
          "-m",
          "pytest"
        ],
        [
          "node",
          "--check",
          "docker/check.mjs"
        ]
      ]
    },
    {
      "id": "web",
      "name": "KinopioHub.web",
      "repository": "skyboooox/KinopioHub.web",
      "path": "KinopioHub.web",
      "role": "Web debugger and console",
      "language": "TypeScript",
      "visibility": "public",
      "defaultBranch": "main",
      "license": "GPL-3.0-or-later",
      "setup": [
        [
          "npm",
          "install"
        ]
      ],
      "test": [
        [
          "npm",
          "run",
          "typecheck"
        ],
        [
          "npm",
          "run",
          "build"
        ]
      ]
    },
    {
      "id": "arduino",
      "name": "KinopioHub.ino",
      "repository": "skyboooox/KinopioHub.ino",
      "path": "KinopioHub.ino",
      "role": "ESP32 Arduino SDK",
      "language": "C++",
      "visibility": "public",
      "defaultBranch": "main",
      "license": "GPL-3.0-or-later",
      "setup": [
        [
          "pio",
          "pkg",
          "install"
        ]
      ],
      "test": [
        [
          "pio",
          "run"
        ],
        [
          "node",
          "test/protocol.mjs"
        ],
        [
          "node",
          "test/transport-flush.mjs"
        ],
        [
          "node",
          "test/transport-certificate-dates.mjs"
        ],
        [
          "node",
          "test/transport-send.mjs"
        ],
        [
          "node",
          "test/transport-readiness.mjs"
        ],
        [
          "node",
          "test/transport-readline.mjs"
        ],
        [
          "node",
          "test/transport-line-chunks.mjs"
        ],
        [
          "node",
          "test/messaging.mjs"
        ]
      ]
    },
    {
      "id": "cpp",
      "name": "KinopioHub.cpp",
      "repository": "skyboooox/KinopioHub.cpp",
      "path": "KinopioHub.cpp",
      "role": "Native C++20 SDK",
      "language": "C++",
      "visibility": "public",
      "defaultBranch": "main",
      "license": "GPL-3.0-or-later",
      "setup": [
        [
          "cmake",
          "-S",
          ".",
          "-B",
          "build-v3",
          "-DBUILD_TESTING=ON"
        ]
      ],
      "test": [
        [
          "cmake",
          "--build",
          "build-v3"
        ],
        [
          "ctest",
          "--test-dir",
          "build-v3",
          "--output-on-failure"
        ]
      ]
    },
    {
      "id": "server",
      "name": "Kinopio-server",
      "repository": "skyboooox/Kinopio-server",
      "upstream": "nats-io/nats-server",
      "path": "Kinopio-server",
      "role": "NATS Server fork with wildcard subscription changes",
      "language": "Go",
      "visibility": "public",
      "defaultBranch": "main",
      "license": "Apache-2.0",
      "setup": [],
      "test": [
        [
          "go",
          "test",
          "./..."
        ]
      ]
    }
  ]
}
